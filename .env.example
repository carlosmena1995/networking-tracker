# Copy to .env.local and fill in the values from your Neon project.
# .env.local is git-ignored. Never commit real values.
#
# See docs/neon-setup.md for where each of these comes from.

# ---------------------------------------------------------------------------
# Public - safe to ship to the browser (NEXT_PUBLIC_ is inlined into the bundle)
# ---------------------------------------------------------------------------
# These are HTTPS API endpoints, not credentials. They are protected by Row
# Level Security, not by secrecy: anyone can call them, and without a valid
# session JWT they return nothing.

NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-123456.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example-123456.apirest.c-2.us-east-2.aws.neon.tech/neondb/rest/v1

# ---------------------------------------------------------------------------
# Server-only - MUST NOT be prefixed with NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# Base URL the Next.js server uses to talk to Neon Managed Better Auth.
NEON_AUTH_BASE_URL=https://ep-example-123456.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth

# Signs the session-data cookie. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-32-plus-character-string

# Postgres connection string. Used ONLY to apply db/schema.sql from your
# machine. The application never reads it, and it must never reach the browser.
DATABASE_URL=postgresql://user:password@ep-example-123456.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require
